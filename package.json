{
  "name": "wedding",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run type-check && vite build",
    "check": "bun run type-check && bun test tests/backend",
    "type-check": "vue-tsc --noEmit",
    "pages:dev": "wrangler pages dev dist --compatibility-date 2026-11-04",
    "prepare": "lefthook install",
    "preview": "vite preview --host 127.0.0.1 --port 4174"
  },
  "dependencies": {
    "embla-carousel-vue": "^8.6.0",
    "gsap": "^3.15.0",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.1",
    "lefthook": "^2.2.2",
    "typescript": "~6.0.0",
    "vite": "^7.1.10",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.157.0"
  }
}
